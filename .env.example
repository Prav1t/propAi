# ── Database ──────────────────────────────────────────────
# Runtime connection: a least-privilege role WITHOUT superuser/BYPASSRLS so row-level security applies.
DATABASE_URL=postgres://propai_app:propai_app@localhost:5432/propai
# Migrations + seeding: the schema owner.
MIGRATION_DATABASE_URL=postgres://propai:propai@localhost:5432/propai

# ── App ───────────────────────────────────────────────────
APP_URL=http://localhost:3000
# 32 random bytes, base64. Encrypts MFA secrets. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
ALLOW_REGISTRATION=true
LOG_LEVEL=info

# ── Email ─────────────────────────────────────────────────
# console = store in email_outbox and view at /dev/mailbox (development only)
# smtp    = send via SMTP_URL (Mailpit in docker-compose, or your provider)
MAIL_PROVIDER=console
SMTP_URL=smtp://localhost:1025
MAIL_FROM="[YOUR PRODUCT NAME] <no-reply@example.com>"

# ── File attachments ──────────────────────────────────────
# local = files on disk under FILE_STORAGE_DIR (single instance; mount a volume in Docker)
# s3    = any S3-compatible bucket (AWS S3, MinIO, Cloudflare R2); downloads use 60-second presigned URLs
FILE_STORAGE=local
# FILE_STORAGE_DIR=./.data/uploads
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=                 # set for MinIO/R2 (enables path-style addressing)
# S3_PUBLIC_ENDPOINT=          # host the browser uses for presigned downloads, if different from S3_ENDPOINT
# S3_SSE=AES256                # server-side encryption on upload; `none` for MinIO without a KMS
# Credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, instance role, …)

# ── Background worker (notifications, SLA monitor, scheduled announcements, package reminders) ─
# By default each app instance runs the worker loop in-process every WORKER_INTERVAL_MS.
# With several instances, set DISABLE_INPROCESS_WORKER=true and run `npm run worker` as one separate process
# (or `npm run worker -- --once` from a scheduler).
# DISABLE_INPROCESS_WORKER=false
# WORKER_INTERVAL_MS=30000
# PACKAGE_REMINDER_DAYS=3      # remind residents once about packages waiting this long (perishables: after 1 day)

# ── Development / demo only (ignored or hidden in production) ─
# RATE_LIMITS=relaxed          # E2E runs sign in many times from one IP
# SHOW_DEMO_ACCOUNTS=true      # show demo credentials on /login in a production-mode demo

# ── AI assistant ──────────────────────────────────────────
# Without a provider key the assistant runs in DEMO MODE: fixed rules route common questions and change requests to the
# same tools and answers are composed from tool results only. Every demo answer is labelled in the UI.
# AI_PROVIDER=anthropic        # demo | anthropic | openai | openai-compatible (default: picked from the keys present)
# AI_MODEL=claude-sonnet-5     # anthropic default; required for openai / openai-compatible
# AI_MODEL_FAST=claude-haiku-4-5-20251001   # cheaper tier for classification (routing seam; not used yet)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=          # optional gateway/proxy
# OPENAI_API_KEY=
# OPENAI_BASE_URL=             # optional, e.g. an Azure/OpenAI-compatible gateway
# AI_COMPAT_BASE_URL=http://localhost:11434/v1   # openai-compatible: Ollama, vLLM, LM Studio, Gemini's OpenAI endpoint…
# AI_COMPAT_API_KEY=
# AI_MAX_STEPS=6               # model ↔ tool round trips per answer (1–12)
# AI_TIMEOUT_MS=60000          # whole-answer timeout
# AI_MAX_OUTPUT_TOKENS=1500
# AI_TEMPERATURE=              # leave unset unless your model needs it
# AI_REQUESTS_PER_MINUTE=20    # per person
# AI_MONTHLY_REQUEST_CAP=      # default per-organization monthly cap (admins can change theirs); blank = none
# AI_PRICE_INPUT_PER_MTOK=     # USD per million tokens for the usage page's cost estimate; models without a
# AI_PRICE_OUTPUT_PER_MTOK=    # price record no estimate rather than a guessed one

# ── Knowledge base embeddings (meaning-based search) ──────
# Without a key a local, offline hashing embedder is used (demo quality; keyword search does most of the work).
# All passages are 512-dimensional; after changing the model, re-index from Knowledge base → Re-index everything.
# EMBEDDING_PROVIDER=          # local | voyage | openai | openai-compatible (default: picked from the keys present)
# VOYAGE_API_KEY=              # → voyage-3.5-lite unless EMBEDDING_MODEL is set
# EMBEDDING_MODEL=             # e.g. voyage-3.5, text-embedding-3-small, or your local model's name
# EMBEDDING_API_KEY=           # overrides the provider key for embeddings only
# EMBEDDING_BASE_URL=          # openai-compatible servers (Ollama, vLLM…), or a gateway

# ── Planned (not used yet) ────────────────────────────────
# REDIS_URL=
